#lang zuo
;; CI-only seed generator. This is a gensym namespace, not an action cache key.
(define args (hash-ref (runtime-env) 'args))
(unless (>= (length args) 3)
  (error "usage: chez-session-key.zuo CHEZ_SOURCE PLATFORM RUNNER_IMAGE [--machines=pb,ta6le] [BUILD_CONTEXT ...]"))
(define root (path->complete-path (car args)))
(define contexts (cdr (cddr args)))
;; An omitted machine scope keeps the previous conservative whole-tree behavior.
;; Callers must list every source-built host/target; do not guess from runner arch.
(define machines
  (if (and (pair? contexts) ((glob->matcher "--machines=*") (car contexts)))
      (string-split (substring (car contexts) (string-length "--machines=")) ",")
      #f))
(when (and machines (or (null? machines) (member "" machines)))
  (error "--machines needs a nonempty comma-separated list"))
(define machine-source-names
  (and machines (dynamic-require (build-path root "s/machine.zuo") 'machine-source-names)))
(define (source-names relative names)
  (if (and machines (equal? relative "s"))
      (filter (lambda (name)
                (ormap (lambda (m) (member name (machine-source-names names m))) machines))
              names)
      names))
(define (walk relative)
  (define path (build-path root relative))
  (cond
    [(directory-exists? path)
     (apply append
            (map (lambda (name)
                   (if (member name '(".git" ".hg" ".svn" "compiled")) '()
                       (walk (build-path relative name))))
                 (source-names relative (sort (ls path) string<?))))]
    [else (list (list relative (string-sha256 (file->string path))))]))
(define inputs
  (apply append
         (map walk '("configure" "build.zuo" "c" "s" "makefiles" "unicode"
                     "nanopass/nanopass.ss" "nanopass/nanopass" "lz4" "zlib"
                     "boot/pb/petite.boot" "boot/pb/scheme.boot" "boot/pb/scheme.h"
                     "boot/pb/equates.h" "boot/pb/gc-ocd.inc" "boot/pb/gc-oce.inc"
                     "boot/pb/gc-par.inc" "boot/pb/heapcheck.inc"))))
(define (env-value name)
  (cdr (or (assoc name (hash-ref (runtime-env) 'env)) (cons name ""))))
(define compiler-command (or (and (not (equal? (env-value "CC") "")) (env-value "CC")) "cc"))
(define compiler-argv (shell->strings compiler-command #t))
(define compiler (find-executable-path (car compiler-argv)))
(unless compiler (error "cannot find CI compiler" (car compiler-argv)))
;; The Racket adapter and configure recipe can affect the Chez build settings.
(define adapter-inputs
  (apply append
         (map (lambda (name)
                (define path (build-path root ".." "cs" "c" name))
                (if (file-exists? path) (list (list name (string-sha256 (file->string path)))) '()))
              '("build.zuo" "configure" "configure.ac"))))
(define description
  (list 'ci-chez-session-v2 (cdr args) inputs adapter-inputs
        compiler-command (string-sha256 (file->string compiler))
        (map (lambda (name) (list name (env-value name)))
             '("CPPFLAGS" "CFLAGS" "LDFLAGS" "AR" "ARFLAGS" "RANLIB"
               "CC_FOR_BUILD" "CFLAGS_FOR_BUILD" "CONFIGURE_ARGS"))
        (string-sha256 (file->string (at-source "chez-session-key.zuo")))))
(displayln (~a "ci-chez-" (string-sha256 (~s description))))

#lang racket/base
(require racket/fixnum)
(define N 20000000)
(define m (make-hasheq))
(for ([i 4])
  (hash-set! m i i))
(when (getenv "PAR")
  (thread-wait (thread #:pool 'own (lambda () (hash-ref m 1)))))
(define (go)
  (collect-garbage)
  (define-values (r cpu real gc)
    (time-apply (lambda ()
                  (for ([i (in-range N)])
                    (hash-ref m (fxand i 3) 0)))
                '()))
  real)
(define (go-set)
  (define-values (r cpu real gc)
    (time-apply (lambda ()
                  (for ([i (in-range N)])
                    (hash-set! m (fxand i 3) i)))
                '()))
  real)
(printf "ref ~a set! ~a\n" (go) (go-set))

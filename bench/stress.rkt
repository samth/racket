#lang racket/base
(define W (string->number (or (getenv "W") "4")))
(define ht (make-hasheq))
(define htv (make-hasheqv))
(for ([i 1000])
  (hash-set! ht i i)
  (hash-set! htv (exact->inexact i) i))
(define K 200000)
(define ths
  (for/list ([w W])
    (thread #:pool 'own
            (lambda ()
              (for ([i K])
                (define k (+ 1000 (* w K) i))
                (hash-set! ht k w)
                (hash-set! htv (exact->inexact k) w)
                (unless (eqv? w (hash-ref ht k #f))
                  (error "lost own write"))
                (hash-ref ht (random 1000) #f)
                (when (zero? (modulo i 3))
                  (hash-remove! ht k)
                  (hash-set! ht k w)))))))
(for ([i K])
  (hash-ref ht (random 1000) #f)
  (hash-set! ht (random 1000) i))
(for-each thread-wait ths)
(unless (and (= (hash-count ht) (+ 1000 (* W K))) (= (hash-count htv) (+ 1000 (* W K))))
  (error "bad count"))

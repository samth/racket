#lang racket/base
(require racket/list racket/port racket/runtime-path)
(define-runtime-path default-dir "..")
(define dir
  (if (zero? (vector-length (current-command-line-arguments)))
      default-dir
      (path->complete-path (vector-ref (current-command-line-arguments) 0))))
(define (api name)
  (define path (build-path dir name))
  (dynamic-require path #f)
  (lambda (name) (parameterize ([current-namespace (module->namespace path)]) (eval name))))
(define checks 0)
(define (check actual expected label)
  (unless (equal? actual expected) (error 'check "~a: ~s != ~s" label actual expected))
  (set! checks (add1 checks)))
(define dna-api (api "knucleotide.rkt"))
(random-seed 9182601)
(for ([n '(0 1 2 3 4 6 7 11 12 17 18 19 31 64 257 1000 10000)])
  (define dna (list->bytes (for/list ([i (in-range n)]) (bytes-ref #"ACGT" (random 4)))))
  (define encoded ((dna-api 'encode-dna) dna))
  (define results ((dna-api 'parallel-counts) encoded))
  (for ([job (in-vector (dna-api 'jobs))] [table (in-vector results)])
    (define len (car job))
    (define expected (make-hash))
    (for ([i (in-range (cdr job) (max 0 (add1 (- n len))) len)])
      (hash-update! expected (subbytes dna i (+ i len)) add1 0))
    (check (hash-count table) (hash-count expected) 'frame-cardinality)
    (for ([(key count) (in-hash table)])
      (check (unbox count) (hash-ref expected ((dna-api 'key->bytes) key len)) 'frame-entry)))
  (for ([len '(1 2 3 4 6 12 18)])
    (define tables ((dna-api 'tables-for) results len))
    (define table ((dna-api 'merge-counts) tables))
    (define expected ((dna-api 'all-counts) len encoded))
    (check (hash-count table) (hash-count expected) 'merged-cardinality)
    (for ([(key count) (in-hash table)])
      (check (unbox count) (unbox (hash-ref expected key)) 'merged-entry))))
(define rx-api (api "regexredux.rkt"))
(define cases
  (append
   (list #"" #"a" #"BYBYBYBY" #"tHaNtHaSaNDcaNHaDWaSaNaSaTBY<>||x||"
         #">ONE\nacgt\n>THREE\nagggtaaaTTTACCCT\n" #">no newline"
         #"\0\377tHaN\0BY\377<abc>||x|" #"<><><><>|x|y|z||")
   (for/list ([n (in-range 250)])
     (define chunks '#(#"tHaN" #"tHat" #"aND" #"caN" #"HaD" #"WaS" #"BY"
                       #"aN" #"aS" #"at" #"<>" #"<abc>" #"|" #"\n" #">THREE\n"
                       #"agggtaaa" #"tttaccct" #"A" #"x" #"\0\377"))
     (apply bytes-append (for/list ([i (in-range (random 100))])
                           (vector-ref chunks (random (vector-length chunks))))))))
(for ([input (in-list cases)])
  (define stripped ((rx-api 'strip-input) input))
  (check stripped (regexp-replace* #rx#"(?:>.*?\n)|\n" input #"") 'stripped)
  (define expected stripped)
  (for ([rule (in-list (rx-api 'IUBS))])
    (define rx (byte-regexp (car rule)))
    (define after (regexp-replace* rx expected (cadr rule)))
    (for ([capacity '(0 1 16 1024)])
      (define-values (actual len)
        ((rx-api 'replace-into) rx (bytes-append expected #"BYtHaN") (bytes-length expected)
                                (cadr rule) (make-bytes capacity)))
      (check (subbytes actual 0 len) after 'full-intermediate))
    (set! expected after))
  (define-values (result len) ((rx-api 'replace-sequence) stripped))
  (check (subbytes result 0 len) expected 'buffer-reuse-final))
(printf "PASS ~a checks: all 46 frame histograms and complete regex intermediate strings\n" checks)

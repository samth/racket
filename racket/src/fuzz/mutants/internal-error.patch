Breaks the check "Racket reports no internal error." in racket/src/fuzz/driver.c.
Caught by the seed input "eval-error" of racket_eval_fuzzer.

diff --git a/racket/src/fuzz/safe-eval.rkt b/racket/src/fuzz/safe-eval.rkt
--- a/racket/src/fuzz/safe-eval.rkt
+++ b/racket/src/fuzz/safe-eval.rkt
@@ -74,7 +74,7 @@
   (and (exn? e)
        (let ([msg (exn-message e)])
          (or (string-contains? msg "invalid memory reference")
-             (string-prefix? msg "internal error")))))
+             #t))))
 
 ;; A bug's message goes to the original error port, whatever untrusted
 ;; code did to its own, so that a crash report says what went wrong;

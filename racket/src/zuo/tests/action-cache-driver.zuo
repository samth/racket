#lang zuo
(define (targets-at at-dir vars)
  (define input (at-dir "input"))
  (define producer (at-source "action-cache-producer.zuo"))
  (define tool (hash-ref vars 'TOOL (hash-ref (runtime-env) 'exe)))
  (list
   (target (at-dir "a")
           (lambda (path token)
             (command-rule
              (list input)
              (hash 'argv (list tool "-X" (hash-ref vars 'LIB)
                                producer input path (at-dir "b") (at-dir "runs")
                                (hash-ref vars 'VALUE "one") (hash-ref vars 'FAIL "no") (hash-ref vars 'MODE "regular"))
                    'environment (list (cons "ACTION_TEST" (hash-ref vars 'ENV "fixed")))
                    'toolchain (hash-ref vars 'TOOLCHAIN "test-toolchain-v1")
                    'rule-files (list (at-source "action-cache-driver.zuo") producer))))
           (hash 'co-outputs (list (at-dir "b"))))))
(provide-targets targets-at)

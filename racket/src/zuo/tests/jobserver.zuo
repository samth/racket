#lang zuo

(require "harness.zuo"
         zuo/shell)

(alert "jobserver")

(define unix? (eq? (hash-ref (runtime-env) 'system-type) 'unix))

(define (gnu-make?)
  (define p (shell "make --version" (hash 'stdout 'pipe 'stderr 'pipe)))
  (define out (fd-read (hash-ref p 'stdout) eof))
  (define err (fd-read (hash-ref p 'stderr) eof))
  (fd-close (hash-ref p 'stdout))
  (fd-close (hash-ref p 'stderr))
  (process-wait (hash-ref p 'process))
  (and (= 0 (process-status (hash-ref p 'process)))
       (contains? out "GNU Make")
       (equal? err "")))

(when (and unix? (gnu-make?))
  (define tdir (build-path tmp-dir "jobserver"))
  (rm* tdir)
  (mkdir-p tdir)

  (define jobserver-rel (build-path ".." ".." ".." "lib" "zuo" "jobserver.zuo"))
  (define check-path (build-path tdir "check.zuo"))
  (define check-arg "check.zuo")
  (define mk (build-path tdir "Makefile"))
  (define zuo.exe (hash-ref (runtime-env) 'exe))

  (define check-expr
    `(begin
       (require ,jobserver-rel)
       (define v (maybe-jobserver-jobs))
       (if (integer? v)
           (display "ok\n")
           (begin (display "no\n") (exit 1)))))

  (let ([out (fd-open-output check-path :truncate)])
    (fd-write out "#lang zuo/base\n")
    (fd-write out (~s check-expr))
    (fd-close out))

  (display-to-file
   (~a "ZUO=" zuo.exe "\n"
       "all:\n"
       "\t@$(ZUO) " check-arg "\n")
   mk
   :truncate)

  (define p (shell "make -j2" (hash 'dir tdir 'stdout 'pipe 'stderr 'pipe)))
  (define out (fd-read (hash-ref p 'stdout) eof))
  (define err (fd-read (hash-ref p 'stderr) eof))
  (fd-close (hash-ref p 'stdout))
  (fd-close (hash-ref p 'stderr))
  (process-wait (hash-ref p 'process))

  (check (process-status (hash-ref p 'process)) 0)
  (check (contains? out "ok") #t)
  (check err ""))
